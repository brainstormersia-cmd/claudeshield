# ClaudeShield Website Environment Variables

NEXT_PUBLIC_CURRENT_VERSION=v3.1.0
NEXT_PUBLIC_GITHUB_REPOSITORY_URL=https://github.com/brainstormersia-cmd/agentrouter-autoretry-claudecode
NEXT_PUBLIC_DOWNLOAD_URL=https://raw.githubusercontent.com/brainstormersia-cmd/agentrouter-autoretry-claudecode/main/retry-proxy.py
NEXT_PUBLIC_DOCUMENTATION_URL=/docs
NEXT_PUBLIC_SUPPORT_URL=https://github.com/brainstormersia-cmd/agentrouter-autoretry-claudecode/issues
NEXT_PUBLIC_AGENTROUTER_URL=https://agentrouter.org

# Status endpoint for real telemetry (the proxy exposes /stats)
NEXT_PUBLIC_STATUS_ENDPOINT=http://localhost:8787/stats

# GitHub stars are fetched server-side via /api/github-stars (cached 10min)
# No env var needed - hardcoded to the repo above
